# Base image for all three GPU pools (analyzer, indexer, renderer).
#
# Model weights are NOT baked in. They live on a read-only EFS/FSx volume,
# mmap'ed at startup. Baking 40GB+ of weights into the image would destroy
# deploy velocity for no benefit -- the node-local NVMe caches the hot set.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12 python3-pip \
      # ffmpeg with NVENC/NVDEC. Software encode would roughly double render
      # cost, so hardware codec support is not optional here.
      ffmpeg libavcodec-extra \
      libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/common /app/services/common
RUN pip3 install --no-cache-dir -e /app/services/common

ARG SERVICE
COPY services/${SERVICE} /app/services/${SERVICE}
RUN pip3 install --no-cache-dir -e /app/services/${SERVICE}

ENV REELSEDITS_MODEL_DIR=/models \
    REELSEDITS_VRAM_MB=24576
VOLUME ["/models"]

CMD ["python3", "-m", "reelsedits_worker"]
